# Copy this file to .env and adjust as needed. DRIFTLY works with zero
# configuration - these are all optional overrides.

# --- Persistence -------------------------------------------------------
DATABASE_URL=sqlite:///data/driftly.db

# --- Source --------------------------------------------------------------
# Set SOURCE_URL=demo to run fully offline against the bundled fixture in
# data/demo_fixture.json (useful for a live demo with no internet).
# Any other value is treated as a public JSON feed URL, e.g. the RemoteOK
# public jobs API (no authentication required).
SOURCE_NAME=RemoteOK Public Feed
SOURCE_URL=https://remoteok.com/api

# --- Networking / resilience --------------------------------------------
REQUEST_TIMEOUT=10
MAX_RETRIES=3
BACKOFF_BASE=0.5
BACKOFF_MAX=8
DRIFTLY_USER_AGENT=DriftlyBot/1.0 (+engineering-assessment-demo)
DEGRADED_AFTER_FAILURES=1
UNAVAILABLE_AFTER_FAILURES=3

# --- Server ---------------------------------------------------------------
DRIFTLY_HOST=127.0.0.1
DRIFTLY_PORT=8080
